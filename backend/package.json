    "tiny-secp256k1": "^2.2.4",
    "tronweb": "^6.0.0"
  },
  "devDependencies": {
    "@types/bip32": "^1.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
