# White-Label
NEXT_PUBLIC_SITE_NAME="Your Site Name"
NEXT_PUBLIC_TOKEN_NAME="TOKEN"
NEXT_PUBLIC_PRIMARY_COLOR="#D4AF37"
NEXT_PUBLIC_ACCENT_COLOR="#8B0000"
NEXT_PUBLIC_SITE_TAGLINE="Your tagline"
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Backend
NODE_ENV=production
DATABASE_URL="file:/app/data/prod.db"
API_URL=https://your-domain.com/api
JWT_SECRET=<random-64-char-string>
ADMIN_EMAIL=admin@your-domain.com

# Resend (Email)
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM_EMAIL=noreply@your-domain.com

# Storj S3 Storage
STORJ_ENDPOINT=https://gateway.us1.storjshare.io
STORJ_ACCESS_KEY_ID=<your-storj-access-key>
STORJ_SECRET_ACCESS_KEY=<your-storj-secret-key>
STORJ_BUCKET=jessica-su
STORJ_PRESIGN_EXPIRY=86400

# NOWPayments (Crypto Payments)
NOWPAYMENTS_API_KEY=<your-nowpayments-api-key>
NOWPAYMENTS_IPN_SECRET=<your-nowpayments-ipn-secret>
NOWPAYMENTS_CALLBACK_URL=https://your-domain.com/api/webhooks/nowpayments
